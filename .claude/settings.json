{
  "permissions": {
    "defaultMode": "default",
    "deny": [
      "Read(~/.ssh/**)",
      "Read(~/.aws/**)",
      "Read(~/.config/**)",
      "Read(.env)",
      "Read(.env.*)",
      "Read(**/.env)",
      "Write(~/.ssh/**)",
      "Edit(~/.ssh/**)",
      "Write(**/.env)",
      "Edit(**/.env)",

      "Write(~/Library/CloudStorage/**)",
      "Edit(~/Library/CloudStorage/**)",

      "Bash(rm -rf:*)",
      "Bash(rm -fr:*)",
      "Bash(rm -r:*)",
      "Bash(sudo:*)",
      "Bash(wget:*)",
      "Bash(nc:*)",
      "Bash(cp:*)",
      "Bash(rsync:*)",
      "Bash(scp:*)",

      "Bash(git push --force:*)",
      "Bash(git push -f:*)",
      "Bash(git push --force-with-lease:*)",
      "Bash(git reset --hard:*)",
      "Bash(git clean:*)",
      "Bash(git branch -d:*)",
      "Bash(git branch -D:*)",

      "Edit(**/dist/**)",
      "Write(**/dist/**)",

      "Edit(**/*_PLAN.md)",
      "Write(**/*_PLAN.md)",
      "Edit(transformism/refactor_plan.md)",
      "Write(transformism/refactor_plan.md)",
      "Edit(ARCHIVE.md)",
      "Write(ARCHIVE.md)",
      "Edit(.claude/**)",
      "Write(.claude/**)",
      "Edit(/CLAUDE.md)",
      "Write(/CLAUDE.md)",

      "Bash(aws iam:*)",
      "Bash(aws ec2 terminate-instances:*)",
      "Read(**/*.tfstate)",
      "Edit(**/*.tfstate)",
      "Write(**/*.tfstate)",
      "Read(**/*.tfvars)",
      "Edit(**/*.tfvars)",
      "Write(**/*.tfvars)",
      "Read(**/*.pem)"
    ],
    "ask": [
      "Edit(docs/**)",
      "Write(docs/**)",
      "Edit(infra/docs/**)",
      "Write(infra/docs/**)",
      "Edit(infra/runbooks/**)",
      "Write(infra/runbooks/**)",

      "Bash(terraform apply:*)",
      "Bash(terraform destroy:*)",
      "Bash(ssh:*)",
      "Bash(curl:*)",

      "Bash(brew install:*)",
      "Bash(git restore:*)",
      "Bash(git submodule deinit:*)",
      "Bash(git tag -d:*)"
    ],
    "allow": [
      "Read(./**)",
      "Glob(./**)",
      "Grep(./**)",
      "Write(./**)",
      "Edit(./**)",
      "Bash",

      "Bash(pip install:*)",
      "Bash(pip3 install:*)",
      "Bash(git add:*)",
      "Bash(git commit:*)",
      "Bash(git push)",
      "Bash(git push origin:*)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",

      "Bash(python3 scripts/*)",
      "Bash(python3 ./scripts/*)",
      "Bash(python3.11 scripts/*)",
      "Bash(python3.11 ./scripts/*)",

      "Bash(aws --version*)"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR/infra/scripts/cost-hook.sh\""
          }
        ]
      }
    ]
  }
}