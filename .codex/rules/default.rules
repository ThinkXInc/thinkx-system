# thinkx-system/.codex/rules/default.rules
#
# Command policy mapped from .claude/settings.json.
#

prefix_rule(pattern = ["rm", ["-rf", "-fr", "-r"]], decision = "forbidden", justification = "Use a recoverable, explicitly scoped operation instead.")
prefix_rule(pattern = ["sudo"], decision = "forbidden", justification = "Owner-only operation under the repository policy.")
prefix_rule(pattern = ["wget"], decision = "forbidden", justification = "Use an approved, narrowly scoped retrieval method.")
prefix_rule(pattern = ["nc"], decision = "forbidden", justification = "Network utility prohibited by repository policy.")
prefix_rule(pattern = ["cp"], decision = "forbidden", justification = "Use apply_patch for repository file changes.")
prefix_rule(pattern = ["rsync"], decision = "forbidden", justification = "File transfer prohibited by repository policy.")
prefix_rule(pattern = ["scp"], decision = "forbidden", justification = "Secret and file transfer is owner-only.")

prefix_rule(pattern = ["git", "push", ["--force", "-f", "--force-with-lease"]], decision = "forbidden", justification = "Force push is prohibited.")
prefix_rule(pattern = ["git", "reset", "--hard"], decision = "forbidden", justification = "Destructive Git reset is prohibited.")
prefix_rule(pattern = ["git", "clean"], decision = "forbidden", justification = "Destructive Git cleanup is prohibited.")
prefix_rule(pattern = ["git", "branch", ["-d", "-D"]], decision = "forbidden", justification = "Branch deletion is prohibited.")

prefix_rule(pattern = ["aws", "iam"], decision = "forbidden", justification = "IAM mutations are prohibited.")
prefix_rule(pattern = ["aws", "ec2", "terminate-instances"], decision = "forbidden", justification = "EC2 termination is prohibited.")

prefix_rule(pattern = ["ssh"], decision = "prompt", justification = "Remote execution requires owner approval.")
prefix_rule(pattern = ["curl"], decision = "prompt", justification = "Network retrieval requires owner approval.")
prefix_rule(pattern = ["terraform", ["apply", "destroy"]], decision = "prompt", justification = "Terraform mutation requires owner approval.")
prefix_rule(pattern = ["brew", "install"], decision = "prompt", justification = "System package installation requires owner approval.")
prefix_rule(pattern = ["git", "restore"], decision = "prompt", justification = "Restoring files may discard owner changes.")
prefix_rule(pattern = ["git", "submodule", "deinit"], decision = "prompt", justification = "Submodule deinitialization requires owner approval.")
prefix_rule(pattern = ["git", "tag", "-d"], decision = "prompt", justification = "Tag deletion requires owner approval.")
