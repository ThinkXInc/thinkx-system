[Unit]
Description=Claude Code tmux session (staging editing, auto-start on boot)
After=network-online.target
Wants=network-online.target

[Service]
Type=forking
User=kaz
Environment=HOME=/home/kaz
# claude は kaz の ~/.npm-global 配下のみ(root install 廃止 2026-09-28)。systemd の既定 PATH には無い
Environment=PATH=/home/kaz/.npm-global/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
WorkingDirectory=/src/thinkx-system
ExecStart=/usr/bin/tmux new-session -d -s claude -c /src/thinkx-system "claude --remote-control"
ExecStop=/usr/bin/tmux kill-session -t claude
RemainAfterExit=yes

[Install]
WantedBy=multi-user.target
