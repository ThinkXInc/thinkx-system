[Unit]
Description=Claude Code tmux session (staging editing, auto-start on boot)
After=network-online.target
Wants=network-online.target

[Service]
Type=forking
User=kaz
Environment=HOME=/home/kaz
WorkingDirectory=/src/thinkx-system
ExecStart=/usr/bin/tmux new-session -d -s claude -c /src/thinkx-system "claude --remote-control"
ExecStop=/usr/bin/tmux kill-session -t claude
RemainAfterExit=yes

[Install]
WantedBy=multi-user.target
