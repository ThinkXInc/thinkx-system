# このファイルを terraform.tfvars にコピーして値を埋める。
# terraform.tfvars は .gitignore 済み(コミットしない・Claude Code 読み取り禁止)。
#
#   cp terraform.tfvars.example terraform.tfvars
#   vim terraform.tfvars

# SSH を許可する自分の拠点グローバル IP(必ず /32)
my_office_ip = "203.0.113.5/32"

# 事前に AWS で作成したキーペア名
key_name = "supercom"

# プロジェクトキー
# project = "supercom"
