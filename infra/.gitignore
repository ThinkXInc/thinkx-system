# secrets / state — 絶対にコミットしない
*.tfstate
*.tfstate.*
*.tfvars
!*.tfvars.example
*.pem
*.key
.terraform/
.terraform.lock.hcl
crash.log
override.tf
override.tf.json
*_override.tf

# nginx conf のバックアップ(setup が作る)
*.conf.bak

certs/*
deploykeys/*
!deploykeys/gen_deploy_key.sh
env/*
.env
terraform/terraform.tfvars.bak

# envs/ の env 指定と共有 tfvars への symlink はコミットする(実体の tfvars は上の ignore のまま)
!envs/*/env.auto.tfvars
!envs/*/office.auto.tfvars
