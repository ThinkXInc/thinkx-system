# 環境・依存（再現は requirements.txt で行う）
venv/
.venv-openai/
__pycache__/
*.pyc

# データ・生成物。edit/ の判断データと編集履歴だけは git で運ぶ(D-52)。
# edit_save_journal.jsonl(復旧用の受信ジャーナル)は端末ローカルに残し git 外
data/**
!data/*/
!data/*/edit/
!data/*/edit/*.json
!data/*/edit/segments_history.jsonl
!data/*/edit/clip_*_history.jsonl
!data/*/edit/transcript_edits_history.jsonl
*.mp4
*.m4a
*.wav
*.srt
*.vtt

# 認証・秘密
.env
*.pem
id_*

# OS
.DS_Store
.claude/worktrees/

# 編集データのバックアップ(CLIP_PLAN C-0。git 外・ローカル保険)
backup/

# 切り抜き用資産(CLIP_PLAN)。フォントは大容量+ライセンス上リポジトリ配布不可がありうる。
# 背景動画は大容量。README だけ追跡して置き場の説明を残す
assets/fonts/*
!assets/fonts/README.md
assets/clip_backgrounds/*
!assets/clip_backgrounds/README.md

# ブラウザ再生用の派生音源（元音源から再生成できる）
preview_audio.m4a
checkpoints/
venv_enhance/

# 切り抜き動画の置き場(オーナー指示 2026-10-02・原文 L131)
clipvideo/
