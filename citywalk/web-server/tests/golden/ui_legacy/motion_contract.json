{
  "schema": 1,
  "source": "legacy Create Guide runtime",
  "viewport": {
    "width": 1490,
    "height": 856
  },
  "capture_required_flows": [
    "content-selection",
    "edit-panel-close",
    "map-pan-zoom",
    "translation-panel-populate",
    "translation-panel-update",
    "target-user-dropdown"
  ],
  "flows": [
    {
      "id": "content-selection",
      "trigger": "click #contentTableView_0",
      "order": [
        "four content cells fade and translate left with 50 ms stagger",
        "content table reaches onclosecomplete",
        "page back control appears",
        "edit content view appears"
      ],
      "numeric": {
        "cell_count": 4,
        "cell_stagger_ms": 50,
        "cell_animation_ms": 400,
        "cell_translate_x_px": -20,
        "table_opacity_ms": 200,
        "back_control_animation_ms": 400,
        "back_control_easing": "cubic-bezier(.65,0,.34,1)"
      }
    },
    {
      "id": "edit-panel-close",
      "trigger": "click #pageNavigationView .backbutton",
      "order": [
        "edit content view emits onclosestart",
        "edit content view fades out",
        "content list is reconstructed and shown",
        "page navigation returns to top state"
      ],
      "numeric": {
        "panel_opacity_ms": 100,
        "panel_easing": "easeInSine"
      }
    },
    {
      "id": "translation-panel-close",
      "trigger": "TranslateResultsTableViewState.onclosestart",
      "order": [
        "translation result cells close with 50 ms stagger",
        "translation panel opacity reaches zero",
        "panel emits onclosecomplete and is hidden"
      ],
      "numeric": {
        "cell_stagger_ms": 50,
        "panel_opacity_ms": "50 * result_cell_count",
        "panel_easing": "easeInSine"
      }
    },
    {
      "id": "map-pan-zoom",
      "trigger": "map.panBy(160, 80); map.setZoom(map.getZoom() + 1)",
      "order": [
        "map center changes",
        "map zoom increases by exactly one"
      ],
      "numeric": {
        "pan_x_px": 160,
        "pan_y_px": 80,
        "zoom_delta": 1
      }
    },
    {
      "id": "translation-panel-populate",
      "trigger": "edit demo-derived label, title, and body; wait for test-only completion fixture",
      "order": [
        "valid form change is observed",
        "eleven completed translations arrive in the production-demo order",
        "translation footer becomes visible"
      ],
      "numeric": {
        "result_count": 11,
        "fixture_stagger_ms": 120
      }
    },
    {
      "id": "translation-panel-update",
      "trigger": "extend the demo-derived body with its 27km collider clause",
      "order": [
        "body text is extended",
        "existing translations are replaced as fixture completions arrive",
        "result count remains eleven"
      ],
      "numeric": {
        "result_count": 11,
        "fixture_stagger_ms": 120
      }
    },
    {
      "id": "target-user-dropdown",
      "trigger": "open target-user dropdown and select data-value 2",
      "order": [
        "four-item menu opens above the control",
        "high-literacy item is selected",
        "menu closes and selected title is reflected"
      ],
      "numeric": {
        "item_count": 4,
        "selected_value": 2
      }
    }
  ],
  "comparison": {
    "required": [
      "event order",
      "held-state order",
      "duration and stagger",
      "element trajectory"
    ],
    "map_tiles": "masked; map API center, zoom, and pointer state remain live assertions"
  }
}
