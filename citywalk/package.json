{
  "name": "citywalk-rebuild",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "build:legacy-ui:js": "babel legacy/www/server/application/views/src/ECMA --out-dir web-server/tests/.build/js --presets @babel/preset-env",
    "capture:legacy-motion": "npm run build:legacy-ui:js && node web-server/tests/ui/capture_legacy_motion.js",
    "build:motion-review": "sh web-server/tests/build_motion_review.sh",
    "freeze:legacy-motion": "npm run capture:legacy-motion && npm run validate:motion-trace && npm run build:motion-review",
    "test:legacy-server": "web-server/venv-legacy/bin/python -m unittest discover -s web-server/tests -p 'test_legacy_ui_server.py'",
    "test:motion-contract": "node --test web-server/tests/ui/motion_contract.test.js",
    "test:motion-screencast": "node --test web-server/tests/ui/capture_legacy_motion.test.js",
    "test:motion-trace": "node --test web-server/tests/ui/validate_motion_trace.test.js",
    "validate:motion-trace": "node web-server/tests/ui/validate_motion_trace.js",
    "test:ui": "npm run build:legacy-ui:js && node --test web-server/tests/ui/ui_legacy.test.js"
  },
  "devDependencies": {
    "@babel/cli": "7.14.3",
    "@babel/core": "7.14.3",
    "@babel/preset-env": "7.14.4",
    "jsdom": "26.1.0",
    "less": "4.2.2",
    "playwright-core": "1.53.1"
  }
}
